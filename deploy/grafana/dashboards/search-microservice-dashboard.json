        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum(rate(search_elasticsearch_index_duration_seconds_bucket{operation=\"index\"}[5m])) by (le))",
          "legendFormat": "P50 Index Latency",
